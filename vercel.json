{
  "buildCommand": "cd my-website && npm install && npm run build",
  "installCommand": "cd my-website && npm install",
  "devCommand": "cd my-website && npm run start",
  "outputDirectory": "my-website/build",
  "routes": [
    {
      "src": "/_next/static/(.*)",
      "headers": { "cache-control": "public,max-age=31536000,immutable" }
    },
    {
      "src": "/static/(.*)",
      "headers": { "cache-control": "public,max-age=31536000,immutable" }
    },
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public,max-age=31536000,immutable" }
    },
    {
      "src": "/(.*\\.(?:css|js|gif|jpg|jpeg|png|webp|svg|woff|woff2|ttf|otf|eot))",
      "headers": { "cache-control": "public,max-age=31536000,immutable" }
    },
    { "src": "/(.+)", "dest": "/$1.html" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}